<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.library</groupId>
    <artifactId>LibraryManagement</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!-- === Dependencies === -->
    <dependencies>
        <!-- Spring Core + Beans + Context in one shot -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>6.2.7</version> <!-- latest stable, Jun 2025 ➜ :contentReference[oaicite:0]{index=0} -->
        </dependency>
    </dependencies>

    <!-- === Build plugins === -->
    <build>
        <plugins>
            <!-- Compile with Java 21 (Temurin in your PATH) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration><release>21</release></configuration>
            </plugin>

            <!-- Allow `mvn exec:java` to run MainApp -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>  <!-- May 2025 release ➜ :contentReference[oaicite:1]{index=1} -->
                <configuration>
                    <mainClass>com.library.MainApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
